# Example environment variables for the project
# Copy this file to .env and edit values for your environment

# API
PORT=3001
DATABASE_URL=postgres://netuser:netpass@db:5432/netdb
DB_SSL=false
JWT_SECRET=your_jwt_secret_here

# Frontend
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:3001

# TMDB (if used)
TMDB_BEARER=your_tmdb_bearer_here
